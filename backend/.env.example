# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# AWS Bedrock Configuration - Bearer Token (from AWS Console)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here
AWS_REGION=ap-south-1

# Optional: OpenAI API (for Whisper STT only if not using AWS Transcribe)
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google-credentials.json
GOOGLE_CLOUD_PROJECT=your_project_id

# Optional: Claude API (alternative to GPT-4o)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Session Configuration
SESSION_TIMEOUT_MS=3600000
MAX_FILE_SIZE_MB=10
